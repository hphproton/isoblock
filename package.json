{
  "name": "isoblock",
  "version": "0.1.0",
  "description": "Isometric scene layout as data: validate, check, render and describe.",
  "type": "module",
  "private": true,
  "bin": {
    "isoblock": "dist/isoblock.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "esbuild src/cli/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/isoblock.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.0"
  }
}
